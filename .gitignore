# Quartus: everything except .qpf .qsf .sdc is regenerated
quartus/db/
quartus/incremental_db/
quartus/output_files/
quartus/greybox_tmp/
quartus/simulation/
quartus/*.qws
quartus/*.rpt
quartus/*.summary
quartus/*.smsg
quartus/*.jdi
quartus/*.pin
quartus/*.done
quartus/*.sld
quartus/*.bak
quartus/*.qarlog
quartus/c5_pin_model_dump.txt

# Simulation
sim/build/
sim/*.vcd
sim/*.fst
sim/sim_build/
sim/results.xml
__pycache__/
*.pyc

# KiCad. The project lives in hw/<board>/, so match at any depth under hw/.
# .history/ is KiCad 10 Local History: autosave snapshots in a nested git
# repo. *.lck is the open-file lock, .kicad_prl per-user UI state.
hw/**/*-backups/
hw/**/.history/
hw/**/*.kicad_prl
hw/**/fp-info-cache
hw/**/*.lck
hw/**/_autosave-*
hw/**/*-save.kicad_*
hw/**/*.kicad_sch-bak
hw/**/*.kicad_pcb-bak
hw/**/*~

# Editors and OS. Shared VS Code tasks and settings are tracked.
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
Thumbs.db
desktop.ini
