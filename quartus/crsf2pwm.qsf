# Quartus project for crsf2pwm.
# Device: EPM240T100C5 (MAX II, TQFP-100). Change to match your board.

set_global_assignment -name FAMILY "MAX II"
set_global_assignment -name DEVICE EPM240T100C5
set_global_assignment -name TOP_LEVEL_ENTITY crsf2pwm_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005

# Sources, paths relative to this directory
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/crsf2pwm_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/uart_rx.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/crc8.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/crsf_parser.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/pwm_timebase.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/pwm_chan.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/pwm_out.sv
set_global_assignment -name SDC_FILE crsf2pwm.sdc

# Unused pins: input with weak pull-up instead of output driving ground.
# Safe for a board where other things are wired to the pins.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED WITH WEAK PULL-UP"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to *

# Pin assignments for the own board, see docs/pinout.md. clk on GCLK3 (pin 64,
# bank 2, package side 3). steer, throttle and rx each take a pair of adjacent
# package pins, 49+50, 51+52 and 54+55: the port sits on the first pin, the
# second is reserved below as a tri-stated input and both pads are joined on
# the board. A solder bridge inside a pair changes nothing and the pad is
# twice as wide. 53, 56 and 57 stay free as spacers. The pairs straddle the
# bank 1 / bank 2 boundary (51 / 52), both banks run at 3.3 V. GCLK0 (12),
# GCLK1 (14) and GCLK2 (62) stay free.
set_location_assignment PIN_64 -to clk
set_location_assignment PIN_54 -to rx
set_location_assignment PIN_49 -to steer
set_location_assignment PIN_51 -to throttle

# Second pin of each pair, tri-stated without the pull-up so it does not load
# the line. 58 is tied to VCCIO2 (59) and 61 to GNDIO (60) on the board for
# wider power pads; a tri-stated input is the one state that is safe against
# either rail whatever RESERVE_ALL_UNUSED_PINS above becomes. A reserved pin
# is a named node that exists only here: the location names the pin, the
# RESERVE_PIN assignment makes the fitter create it. (RESERVE_PIN straight
# "-to PIN_50" does not do that: the fitter takes PIN_50 as a node name and
# places it anywhere.)
set_location_assignment PIN_50 -to steer_pair
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to steer_pair
set_location_assignment PIN_52 -to throttle_pair
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to throttle_pair
set_location_assignment PIN_55 -to rx_pair
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to rx_pair
set_location_assignment PIN_58 -to vccio2_pair
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to vccio2_pair
set_location_assignment PIN_61 -to gndio_pair
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to gndio_pair

# Area. The EPM240 has 240 LEs and the design needs 266 with the defaults.
# Packing unrelated LUTs and registers into one LE is what makes it fit;
# area optimisation and binary state encoding buy a few more. Measured with
# 25.1std: 234 of 240, worst setup slack 5.1 ns at 50 MHz. See
# docs/design.md, Resources, for what the RTL could still give back.
set_global_assignment -name AUTO_PACKED_REGISTERS_MAXII "MINIMIZE AREA WITH CHAINS"
set_global_assignment -name OPTIMIZATION_TECHNIQUE AREA
set_global_assignment -name STATE_MACHINE_PROCESSING "MINIMAL BITS"

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"