# Quartus revision for a Cyclone IV E board. Same sources as the MAX II
# revision (crsf2pwm.qsf), different device and pins.
#
# Device: EP4CE6E22C8 is the most common part on cheap Cyclone IV boards.
# Check the marking on the chip and change it if yours differs
# (EP4CE10E22C8, EP4CE10F17C8, EP4CE15F23C8 ...).
#
# Compile:  quartus_sh --flow compile crsf2pwm -c crsf2pwm_c4
# Program:  quartus_pgm -m jtag -o "p;output_files/crsf2pwm_c4.sof"
#           A .sof lives until power-off. For the car, convert it to a .jic
#           for the board's configuration flash (File > Convert Programming
#           Files) and program that instead.

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8
set_global_assignment -name TOP_LEVEL_ENTITY crsf2pwm_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005

# Sources, paths relative to this directory
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/crsf2pwm_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/uart_rx.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/crc8.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/crsf_parser.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/pwm_timebase.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/pwm_chan.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/pwm_out.sv
set_global_assignment -name SDC_FILE crsf2pwm.sdc

# Unused pins: input with weak pull-up instead of output driving ground.
# Safe for a board where SDRAM, LEDs and headers hang on the pins.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED WITH WEAK PULL-UP"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to *

# Board-specific settings to confirm from the board documentation:
# the configuration flash type decides the .jic conversion later.
# set_global_assignment -name CYCLONEIII_CONFIGURATION_DEVICE EPCS16

# Pin assignments. Fill in from docs/pinout.md after checking the board.
# clk must be on a dedicated clock input (CLK0..CLK15 on the E22 package).
# set_location_assignment PIN_23 -to clk
# set_location_assignment PIN_xx -to rx
# set_location_assignment PIN_xx -to steer
# set_location_assignment PIN_xx -to throttle

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"